{
	"schemaVersion": 1,
	"id": "gravity-duplication-return",
	"version": "${version}",
	"name": "Gravity Duplication Return",
	"description": "Restores the classic falling block duplication mechanics at the End Portal that were patched in recent Minecraft versions.",
	"authors": [
		"leopoldoronaldi"
	],
	"license": "CC-BY-4.0",
	"icon": "assets/gravity-duplication-return/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.GravityDuplicationReturn"
		],
		"client": [
			"com.example.client.GravityDuplicationReturnClient"
		]
	},
	"mixins": [
		"gravity-duplication-return.mixins.json",
		{
			"config": "gravity-duplication-return.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.1 <=26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}